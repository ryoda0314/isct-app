# dependencies
node_modules

# next.js
.next/
out/

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# debug
npm-debug.log*

# misc
.DS_Store
*.pem
nul

# encrypted credentials (H7) & secret key (H6)
data/credentials.enc
data/.cred-secret
*.enc

# PWA (auto-generated by next-pwa)
public/sw.js
public/workbox-*.js
public/swe-worker-*.js

# Capacitor native projects
android/
ios/
www/
.vercel

# Portal login debug snapshots (may contain student ID / matrix card)
debug-portal/

# Promo video generated artifacts (VOICEVOX audio / timeline / render output)
promo-video/out/
promo-video/public/voice/
promo-video/public/timeline.json
# Promo video media assets (distributed 立ち絵 PSD/PNG, BGM) — keep README.txt only
promo-video/public/assets/*.psd
promo-video/public/assets/*.png
promo-video/public/bgm/*.mp3
promo-video/public/bgm/*.wav
promo-video/public/bgm/*.m4a
promo-video/public/bgm/*.ogg
promo-video/public/se/*.mp3
promo-video/public/se/*.wav
promo-video/public/se/*.m4a
promo-video/public/se/*.ogg
# Promo video app screenshots (may contain personal data)
promo-video/public/screens/*.png
promo-video/public/screens/*.jpg
promo-video/public/screens/*.jpeg
data/trace-portal-*
data/trace-*.png
# Okta trace output (may contain student ID in screenshots; secrets are masked)
data/okta-trace/

# Device logs (Capacitor bridge logs may contain plugin arguments such as credentials)
logcat*.txt
*.logcat
# SSO / portal / grades debug screenshots (student ID, 2FA, grades)
data/sso-debug-*.png
data/grades-*.png

# 撮った動画・写真（大きい・人が写る。3D マップの作業の参考にだけ使う。GitHub は 100MB より大きいファイルを受け付けない）
/*.MOV
/*.mov
/ScreenRecording_*.mp4
/百年記念館/
/建物/
