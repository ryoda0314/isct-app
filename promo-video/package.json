{
  "name": "scitokyo-promo-video",
  "version": "1.0.0",
  "private": true,
  "description": "ScienceTokyo App 紹介動画（ずんだもん解説）の自動生成パイプライン",
  "type": "module",
  "scripts": {
    "voices": "node generate_voices.mjs",
    "voices:lab": "node generate_voices.mjs --script script-lab.md",
    "studio": "remotion studio src/index.js",
    "render": "remotion render src/index.js PromoVideo out/video.mp4",
    "render:test": "remotion render src/index.js PromoVideo out/test.mp4 --props=./sample-timeline.json",
    "all": "npm run voices && npm run render",
    "promo:sfx": "python make_promo_sfx.py",
    "promo:frames": "node preview_frames.mjs",
    "promo:render": "remotion render src/index.js AppPromo out/app-promo.mp4 --color-space=bt709 --timeout=180000",
    "promo2:capture": "node capture/capture_v2.mjs",
    "promo2:frames": "node preview_frames.mjs --id=AppPromoV2",
    "promo2:render": "remotion render src/index.js AppPromoV2 out/app-promo-v2.mp4 --color-space=bt709 --timeout=180000",
    "story:capture": "node capture/capture_story.mjs",
    "story:frames": "node preview_frames.mjs --id=StoryPromo",
    "story:render": "remotion render src/index.js StoryPromo out/story-promo.mp4 --color-space=bt709 --timeout=180000",
    "fest:capture": "node capture/capture_fest.mjs && python capture/measure_screens.py",
    "fest:frames": "node preview_frames.mjs --id=FestPromo",
    "fest:render": "remotion render src/index.js FestPromo out/fest-promo.mp4 --color-space=bt709 --timeout=180000",
    "film:capture": "node capture/capture_film.mjs && python capture/measure_screens.py film",
    "film:record": "node capture/record_film.mjs && python capture/measure_recs.py && python capture/make_rec_thumbs.py",
    "film:sfx": "python make_film_sfx.py",
    "film:frames": "node preview_frames.mjs --id=AppPromoFilm",
    "film:render": "node render_film.mjs",
    "film:preview": "node render_film.mjs --scale=0.5",
    "x:render": "node render_x.mjs",
    "zunda:voice": "node capture/zunda_voice.mjs",
    "zunda:audio": "python capture/zunda_audio.py",
    "zunda:render": "node render_zunda.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/media-utils": "^4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "^4.0.0",
    "three": "^0.169.0"
  }
}
